{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 500,
  "height": 500,
  "resolve": {
    "legend": {
      "color": "independent"
    }
  },
  "config": {
    "legend": {
      "orient": "none",
      "direction": "horizontal",
      "legendX": 150,
      "legendY": 225
    }
  },
  "data": {
    "url": "https://raw.githubusercontent.com/tonyl15/FIT3179/refs/heads/main/data/Inflation%20rate.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Date": "date:'%b-%y'"
      }
    }
  },
  "params": [
    {
      "name": "city_selection",
      "value": "Australia",
      "bind": {
        "input": "select",
        "options": [
          "Sydney",
          "Melbourne",
          "Brisbane",
          "Adelaide",
          "Perth",
          "Hobart",
          "Darwin",
          "Canberra",
          "Australia"
        ],
        "name": "Select City: "
      }
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "fold": [
            "Sydney",
            "Melbourne",
            "Brisbane",
            "Adelaide",
            "Perth",
            "Hobart",
            "Darwin",
            "Canberra",
            "Australia"
          ],
          "as": [
            "City",
            "Inflation_Rate"
          ]
        },
        {
          "filter": "datum.City == city_selection"
        },
        {
          "calculate": "quarter(datum.Date)",
          "as": "Quarter"
        },
        {
          "calculate": "year(datum.Date)",
          "as": "Year"
        }
      ],
      "mark": {
        "type": "arc",
        "innerRadius": 200,
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "theta": {
          "field": "Year",
          "type": "ordinal",
          "sort": "ascending"
        },
        "radius": {
          "field": "Quarter",
          "type": "ordinal",
          "scale": {
            "type": "band",
            "range": [150, 260]
          }
        },
        "color": {
          "field": "Inflation_Rate",
          "type": "quantitative",
          "title": "Inflation Rate",
          "scale": {
            "domain": [-1.8, 13.1],
            "scheme": "oranges"
          },
          "legend": {
            "labelExpr": "datum.label + '%'"
          }
        },
        "tooltip": [
          {"field": "Quarter", "type": "quantitative", "title": "Quarter"},
          {"field": "Date", "type": "temporal", "title": "Month", "format": "%B"},
          {"field": "Year", "type": "ordinal", "title": "Year"},
          {"field": "Inflation_Rate", "type": "quantitative", "title": "Inflation Rate (%)", "format": ".1f"}
        ]
      }
    },
    {
      "transform": [
        {
          "calculate": "year(datum.Date)",
          "as": "Year"
        }
      ],
      "mark": {
        "type": "text",
        "radius": 280,
        "color": "black"
      },
      "encoding": {
        "theta": {
          "field": "Year",
          "type": "ordinal",
          "sort": "ascending"
        },
        "text": {
          "field": "Year",
          "type": "ordinal"
        }
      }
    },
    {
      "data": {
        "values": [
          {"label": "Q1", "radius": 162.5},
          {"label": "Q2", "radius": 187.5},
          {"label": "Q3", "radius": 212.5},
          {"label": "Q4", "radius": 237.5}
        ]
      },
      "mark": {
        "type": "text",
        "theta": 3.14159,
        "color": "black"
      },
      "encoding": {
        "radius": {
          "field": "radius",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ]
}
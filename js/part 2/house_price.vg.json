{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 600,
  "height": 600,
  "data": {
    "url": "https://raw.githubusercontent.com/tonyl15/FIT3179/refs/heads/main/data/House%20prices.csv"
  },
  "params": [
    {
      "name": "year_select",
      "value": 2001,
      "bind": {
        "input": "range",
        "min": 2001,
        "max": 2024,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.Year == year_select"
        },
        {
          "fold": [
            "Sydney",
            "Melbourne",
            "Brisbane",
            "Adelaide",
            "Perth",
            "Hobart",
            "Darwin",
            "Canberra"
          ],
          "as": [
            "City",
            "House_Price"
          ]
        }
      ],
      "mark": {
        "type": "arc",
        "innerRadius": 50,
        "stroke": "#F0F0F0",
        "strokeWidth": 2
      },
      "encoding": {
        "theta": {
          "field": "City",
          "type": "nominal",
          "scale": {"domain": [
            "Sydney", "Melbourne", "Brisbane", "Adelaide",
            "Perth", "Hobart", "Darwin", "Canberra"
          ]}
        },
        "radius": {
          "field": "House_Price",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [
              200,
              1500
            ],
            "range": [
              80,
              200
            ]
          }
        },
        "tooltip": [
          {
            "field": "City",
            "type": "nominal",
            "title": "City"
          },
          {
            "field": "House_Price",
            "type": "quantitative",
            "title": "House Price ($'000)",
            "format": ",.0f"
          }
        ],
        "color": {
          "value": "#FF8C00"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "price_k": 500
          },
          {
            "price_k": 1000
          },
          {
            "price_k": 1500
          }
        ]
      },
      "mark": {
        "type": "arc",
        "theta": 6.28,
        "stroke": "lightgray",
        "strokeWidth": 1,
        "fill": null,
        "innerRadius": 50
      },
      "encoding": {
        "radius": {
          "field": "price_k",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [
              200,
              1500
            ],
            "range": [
              80,
              200
            ]
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "price_label": "$500K",
            "price_k": 500,
            "theta": 1
          },
          {
            "price_label": "$1M",
            "price_k": 1000,
            "theta": 1
          },
          {
            "price_label": "$1.5M",
            "price_k": 1500,
            "theta": 1
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "color": "black",
        "dx": 5
      },
      "encoding": {
        "theta": {
          "field": "theta",
          "type": "quantitative"
        },
        "radius": {
          "field": "price_k",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [
              200,
              1500
            ],
            "range": [
              80,
              200
            ]
          }
        },
        "text": {
          "field": "price_label",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {"City": "Sydney",   "price_k": 500, "theta": 0.3926990817},
          {"City": "Melbourne", "price_k": 500, "theta": 1.1},
          {"City": "Brisbane",  "price_k": 500, "theta": 1.7},
          {"City": "Adelaide",  "price_k": 500, "theta": 2.4},
          {"City": "Perth",     "price_k": 500, "theta": 3.1},
          {"City": "Hobart",    "price_k": 500, "theta": 3.85},
          {"City": "Darwin",    "price_k": 500, "theta": 4.4},
          {"City": "Canberra",  "price_k": 500, "theta": 5.1},
          {"City": "", "price_k": 500, "theta": 5.5}
        ]},
      "mark": {"type": "text", "fontSize": 12, "fontWeight": "bold", "color": "black", "align": "center", "baseline": "middle"},
      "encoding": {
        "theta": {"field": "theta", "type": "quantitative"},
        "radius": {"field": "price_k", "type": "quantitative", "scale": {"type": "sqrt", "domain": [200, 1500], "range": [80, 200]}},
        "text": {"field": "City", "type": "nominal"}
      }
    }
  ]
}
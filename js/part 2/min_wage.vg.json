{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "https://raw.githubusercontent.com/tonyl15/FIT3179/refs/heads/main/data/Minimum%20wage.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "date:'%Y'"
      }
    }
  },
  "vconcat": [
    {
      "width": 500,
      "height": 250,
      "layer": [
        {
          "mark": "area",
          "encoding": {
            "x": {
              "field": "Date",
              "type": "temporal",
              "scale": {"domain": {"param": "brush"}},
              "axis": {
                "title": null,
                "labelAngle": 0,
                "labelColor": "black",
                "tickColor": "gray",
                "domainColor": "gray"
              }
            },
            "y": {
              "field": "MinWagePerHr",
              "type": "quantitative",
              "axis": {
                "title": "Minimum Wage Per Hr ($)",
                "labelColor": "black",
                "tickColor": "gray",
                "domainColor": "gray"
              },
              "scale": {
                "domain": [
                  0,
                  25
                ]
              }
            },
            "color": {
              "value": "#3887c0"
            },
            "tooltip": [
              {"field": "Date", "type": "temporal", "title": "Year", "format": "%Y"},
              {"field": "MinWagePerHr", "type": "quantitative", "title": "$ Per Hr"}
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "dx": -100,
            "dy": -30
          },
          "encoding": {
            "x": {
              "datum": {"year": 2023},
              "type": "temporal",
              "scale": {"domain": {"param": "brush"}}
            },
            "y": {
              "datum": 20
            },
            "text": {
              "value": "2023 had the greatest increase"
            }
          }
        }
      ]
    },
    {
      "width": 500,
      "height": 50,
      "mark": "area",
      "params": [
        {"name": "brush", "select": {"type": "interval", "encodings": ["x"]}}
      ],
      "encoding": {
        "x": {
          "field": "Date",
          "type": "temporal",
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelColor": "black",
            "tickColor": "gray",
            "domainColor": "gray"
          }
        },
        "y": {
          "field": "MinWagePerHr",
          "type": "quantitative",
          "axis": {
            "title": null,
            "tickCount": 3,
            "grid": false,
            "labelColor": "black",
            "tickColor": "gray",
            "domainColor": "gray"
          }
        },
        "color": {
          "value": "#3887c0"
        }
      }
    }
  ]
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "https://raw.githubusercontent.com/tonyl15/FIT3179/refs/heads/main/data/Minimum%20wage.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "date:'%Y'"
      }
    }
  },
  "width": 600,
  "height": 300,
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": true,
        "strokeWidth": 2,
        "color": "#206fb2"
      },
      "encoding": {
        "x": {
          "field": "Date",
          "type": "temporal",
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelColor": "black",
            "tickColor": "gray",
            "domainColor": "gray"
          }
        },
        "y": {
          "field": "MinWagePerHr",
          "type": "quantitative",
          "axis": {
            "title": "Minimum Wage Per Hr ($)",
            "labelColor": "black",
            "tickColor": "gray",
            "domainColor": "gray"
          },
          "scale": {
            "domain": [
              0,
              25
            ]
          }
        },
        "color": {
          "value": "#FF8C00"
        },
        "tooltip": [
          {"field": "Date", "type": "temporal", "title": "Year", "format": "%Y"},
          {"field": "MinWagePerHr", "type": "quantitative", "title": "$ Per Hr"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dx": -100,
        "dy": -30,
        "fontSize": 12
      },
      "encoding": {
        "x": {
          "datum": {"year": 2023},
          "type": "temporal"
        },
        "y": {
          "datum": 20
        },
        "text": {
          "value": "2023 had the greatest increase"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "fontWeight": "lighter",
        "dx": -350,
        "dy": 80,
        "fontSize": 12
      },
      "encoding": {
        "x": {
          "datum": {"year": 2023},
          "type": "temporal"
        },
        "y": {
          "datum": 20
        },
        "text": {
          "value": "no change from 2008 to 2009"
        }
      }
    }
  ]
}
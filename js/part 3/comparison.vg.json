{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "resolve": {
    "legend": {
      "color": "independent"
    },
    "scale": {
      "color": "independent"
    }
  },
  "params": [
    {
      "name": "year_selection",
      "value": 2021,
      "bind": {
        "input": "range",
        "min": 2001,
        "max": 2021,
        "step": 5,
        "name": "Year: "
      }
    }
  ],
  "hconcat": [
    {
      "width": 300,
      "height": 500,
      "resolve": {
        "scale": {
          "y": "independent"
        }
      },
      "layer": [
        {
          "data": {
            "url": "https://raw.githubusercontent.com/tonyl15/FIT3179/refs/heads/main/data/births_by_state_region.csv"
          },
          "transform": [
            {
              "filter": "datum.year == year_selection"
            }
          ],
          "mark": "bar",
          "encoding": {
            "x": {
              "field": "state",
              "type": "nominal",
              "axis": {
                "title": null,
                "labelColor": "black",
                "tickColor": "gray",
                "domainColor": "gray",
                "labelAngle": 0
              }
            },
            "y": {
              "field": "proportion",
              "type": "quantitative",
              "axis": {
                "title": "Proportion of Residents",
                "format": "%",
                "orient": "left",
                "labelColor": "black",
                "gridColor": "gray",
                "tickColor": "gray",
                "domainColor": "gray"
              },
              "scale": {
                "domain": [
                  0,
                  0.38
                ]
              }
            },
            "color": {
              "field": "region",
              "type": "nominal",
              "legend": {
                "title": "Region of Birth",
                "orient": "left"
              },
              "scale": {
                "scheme": "tableau10"
              }
            },
            "tooltip": [
              {
                "field": "proportion",
                "type": "quantitative",
                "title": "Proportion",
                "format": ".2%"
              },
              {
                "field": "region",
                "type": "nominal",
                "title": "Region"
              }
            ]
          }
        },
        {
          "data": {
            "url": "https://raw.githubusercontent.com/tonyl15/FIT3179/refs/heads/main/data/House%20prices.csv"
          },
          "transform": [
            {
              "filter": "datum.Year == year_selection"
            },
            {
              "fold": [
                "Sydney",
                "Melbourne",
                "Brisbane",
                "Adelaide",
                "Perth",
                "Hobart",
                "Darwin",
                "Canberra"
              ],
              "as": [
                "city",
                "house_price"
              ]
            },
            {
              "calculate": "datum.city == 'Sydney' ? 'NSW' : datum.city == 'Melbourne' ? 'VIC' : datum.city == 'Brisbane' ? 'QLD' : datum.city == 'Adelaide' ? 'SA' : datum.city == 'Perth' ? 'WA' : datum.city == 'Hobart' ? 'TA' : datum.city == 'Darwin' ? 'NT' : datum.city == 'Canberra' ? 'ACT' : datum.city",
              "as": "state"
            },
            {
              "lookup": "Year",
              "from": {
                "data": {
                  "url": "https://raw.githubusercontent.com/tonyl15/FIT3179/refs/heads/main/data/Minimum%20wage.csv"
                },
                "key": "Date",
                "fields": [
                  "MinWagePerWeek"
                ]
              }
            },
            {
              "calculate": "datum.house_price * 1000 / (datum.MinWagePerWeek * 52)",
              "as": "affordability_ratio"
            }
          ],
          "mark": {
            "type": "line",
            "point": true,
            "strokeWidth": 2
          },
          "encoding": {
            "x": {
              "field": "state",
              "type": "nominal",
              "axis": {
                "title": null
              }
            },
            "y": {
              "field": "affordability_ratio",
              "type": "quantitative",
              "axis": {
                "title": "Years of Minimum Wage to Buy House",
                "orient": "right",
                "labelColor": "black",
                    "gridColor": "gray",
                    "tickColor": "gray",
                    "domainColor": "gray"
              },
              "scale": {
                "domain": [
                  0,
                  40
                ]
              }
            },
            "color": {
              "value": "black"
            },
            "tooltip": [
              {
                "field": "house_price",
                "type": "quantitative",
                "title": "House Price ($'000)"
              },
              {
                "field": "MinWagePerWeek",
                "type": "quantitative",
                "title": "Min Wage/Week ($)"
              },
              {
                "field": "affordability_ratio",
                "type": "quantitative",
                "title": "Years to Buy",
                "format": ".1f"
              }
            ]
          }
        }
      ]
    },
    {
      "vconcat": [
        {
          "title": {"text": "Rank by Proportion Overseas-born", "fontSize": 18},
          "width": 380,
          "height": 210,
          "data": {
            "url": "https://raw.githubusercontent.com/tonyl15/FIT3179/refs/heads/main/data/births_by_state_region.csv"
          },
          "transform": [
            {
              "filter": "indexof([2001,2006,2011,2016,2021], datum.year) >= 0"
            },
            {
              "aggregate": [
                {
                  "op": "sum",
                  "field": "proportion",
                  "as": "total_proportion"
                }
              ],
              "groupby": [
                "state",
                "year"
              ]
            },
            {
              "window": [
                {
                  "op": "rank",
                  "as": "rank"
                }
              ],
              "sort": [
                {
                  "field": "total_proportion",
                  "order": "descending"
                }
              ],
              "groupby": [
                "year"
              ]
            }
          ],
          "layer": [
            {
              "mark": {
                "type": "line",
                "interpolate": "monotone"
              },
              "encoding": {
                "x": {
                  "field": "year",
                  "type": "quantitative",
                  "axis": {
                    "title": null,
                    "values": [
                      2001,
                      2006,
                      2011,
                      2016,
                      2021
                    ],
                    "format": "d",
                    "labelColor": "black",
                    "gridColor": "gray",
                    "tickColor": "gray",
                    "domainColor": "gray"
                  }
                },
                "y": {
                  "field": "rank",
                  "type": "quantitative",
                  "axis": {
                    "title": "Rank (1 = Highest)",
                    "labelColor": "black",
                    "tickColor": "gray",
                    "domainColor": "gray"
                  },
                  "scale": {
                    "reverse": true,
                    "domainMin": 1
                  }
                },
                "color": {
                  "field": "state",
                  "type": "nominal",
                  "legend": null
                },
                "detail": {
                  "field": "state"
                },
                "tooltip": [
                  {
                    "field": "state",
                    "type": "nominal",
                    "title": "State"
                  },
                  {
                    "field": "year",
                    "type": "quantitative",
                    "title": "Year",
                    "format": "d"
                  },
                  {
                    "field": "total_proportion",
                    "type": "quantitative",
                    "title": "Proportion",
                    "format": ".2%"
                  },
                  {
                    "field": "rank",
                    "type": "quantitative",
                    "title": "Rank"
                  }
                ]
              }
            },
            {
              "transform": [
                {
                  "filter": "datum.year == year_selection"
                }
              ],
              "mark": {
                "type": "point",
                "filled": true,
                "size": 80
              },
              "encoding": {
                "x": {
                  "field": "year",
                  "type": "quantitative"
                },
                "y": {
                  "field": "rank",
                  "type": "quantitative"
                },
                "color": {
                  "field": "state",
                  "type": "nominal",
                  "legend": null
                }
              }
            },
            {
              "transform": [
                {
                  "calculate": "year_selection",
                  "as": "selYear"
                }
              ],
              "mark": {
                "type": "rule",
                "color": "#666",
                "strokeDash": [
                  4,
                  4
                ]
              },
              "encoding": {
                "x": {
                  "field": "selYear",
                  "type": "quantitative"
                }
              }
            },
            {
              "transform": [
                {
                  "filter": "datum.year == year_selection"
                }
              ],
              "mark": {
                "type": "text",
                "align": "left",
                "baseline": "middle",
                "dx": 6,
                "fontSize": 10
              },
              "encoding": {
                "x": {
                  "field": "year",
                  "type": "quantitative"
                },
                "y": {
                  "field": "rank",
                  "type": "quantitative"
                },
                "text": {
                  "field": "state"
                },
                "color": {
                  "field": "state",
                  "type": "nominal",
                  "legend": null
                }
              }
            }
          ]
        },
        {
          "title": {"text": "Rank by Years of Min Wage to Buy House", "fontSize": 18},
          "width": 380,
          "height": 210,
          "data": {
            "url": "https://raw.githubusercontent.com/tonyl15/FIT3179/refs/heads/main/data/House%20prices.csv"
          },
          "transform": [
            {
              "filter": "indexof([2001,2006,2011,2016,2021], datum.Year) >= 0"
            },
            {
              "fold": [
                "Sydney",
                "Melbourne",
                "Brisbane",
                "Adelaide",
                "Perth",
                "Hobart",
                "Darwin",
                "Canberra"
              ],
              "as": [
                "city",
                "house_price"
              ]
            },
            {
              "calculate": "datum.city == 'Sydney' ? 'NSW' : datum.city == 'Melbourne' ? 'VIC' : datum.city == 'Brisbane' ? 'QLD' : datum.city == 'Adelaide' ? 'SA' : datum.city == 'Perth' ? 'WA' : datum.city == 'Hobart' ? 'TA' : datum.city == 'Darwin' ? 'NT' : datum.city == 'Canberra' ? 'ACT' : datum.city",
              "as": "state"
            },
            {
              "lookup": "Year",
              "from": {
                "data": {
                  "url": "https://raw.githubusercontent.com/tonyl15/FIT3179/refs/heads/main/data/Minimum%20wage.csv"
                },
                "key": "Date",
                "fields": [
                  "MinWagePerWeek"
                ]
              }
            },
            {
              "calculate": "datum.house_price * 1000 / (datum.MinWagePerWeek * 52)",
              "as": "affordability_ratio"
            },
            {
              "window": [
                {
                  "op": "rank",
                  "as": "rank"
                }
              ],
              "sort": [
                {
                  "field": "affordability_ratio",
                  "order": "descending"
                }
              ],
              "groupby": [
                "Year"
              ]
            }
          ],
          "layer": [
            {
              "mark": {
                "type": "line",
                "interpolate": "monotone"
              },
              "encoding": {
                "x": {
                  "field": "Year",
                  "type": "quantitative",
                  "axis": {
                    "title": null,
                    "values": [
                      2001,
                      2006,
                      2011,
                      2016,
                      2021
                    ],
                    "format": "d",
                    "labelColor": "black",
                    "gridColor": "gray",
                    "tickColor": "gray",
                    "domainColor": "gray"
                  }
                },
                "y": {
                  "field": "rank",
                  "type": "quantitative",
                  "axis": {
                    "title": "Rank (1 = Most Years)",
                    "labelColor": "black",
                    "tickColor": "gray",
                    "domainColor": "gray"
                  },
                  "scale": {
                    "reverse": true,
                    "domainMin": 1
                  }
                },
                "color": {
                  "field": "state",
                  "type": "nominal",
                  "legend": null
                },
                "detail": {
                  "field": "state"
                },
                "tooltip": [
                  {
                    "field": "state",
                    "type": "nominal",
                    "title": "State"
                  },
                  {
                    "field": "Year",
                    "type": "quantitative",
                    "title": "Year",
                    "format": "d"
                  },
                  {
                    "field": "affordability_ratio",
                    "type": "quantitative",
                    "title": "Years to Buy",
                    "format": ".1f"
                  },
                  {
                    "field": "rank",
                    "type": "quantitative",
                    "title": "Rank"
                  }
                ]
              }
            },
            {
              "transform": [
                {
                  "filter": "datum.Year == year_selection"
                }
              ],
              "mark": {
                "type": "point",
                "filled": true,
                "size": 80
              },
              "encoding": {
                "x": {
                  "field": "Year",
                  "type": "quantitative"
                },
                "y": {
                  "field": "rank",
                  "type": "quantitative"
                },
                "color": {
                  "field": "state",
                  "type": "nominal",
                  "legend": null
                }
              }
            },
            {
              "transform": [
                {
                  "calculate": "year_selection",
                  "as": "selYear"
                }
              ],
              "mark": {
                "type": "rule",
                "color": "#666",
                "strokeDash": [
                  4,
                  4
                ]
              },
              "encoding": {
                "x": {
                  "field": "selYear",
                  "type": "quantitative"
                }
              }
            },
            {
              "transform": [
                {
                  "filter": "datum.Year == year_selection"
                }
              ],
              "mark": {
                "type": "text",
                "align": "left",
                "baseline": "middle",
                "dx": 6,
                "fontSize": 10
              },
              "encoding": {
                "x": {
                  "field": "Year",
                  "type": "quantitative"
                },
                "y": {
                  "field": "rank",
                  "type": "quantitative"
                },
                "text": {
                  "field": "state"
                },
                "color": {
                  "field": "state",
                  "type": "nominal",
                  "legend": null
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
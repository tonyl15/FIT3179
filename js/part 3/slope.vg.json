{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {"text": "Increase/Decrease in Variables Over Time", "fontSize": 20},
  "data": {
    "url": "https://raw.githubusercontent.com/tonyl15/FIT3179/refs/heads/main/data/rate_of_change.csv"
  },
  "params": [
    {
      "name": "state_selection",
      "bind": {
        "input": "select",
        "options": ["NSW", "VIC", "QLD", "SA", "WA", "TA", "NT", "ACT"],
        "name": "Select State: "
      },
      "value": "NSW"
    }
  ],
  "hconcat": [
    {
      "width": 400,
      "height": 500,
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#898989",
        "strokeWidth": 2,
        "opacity": 0.7
      },
      "encoding": {
        "y": {
          "datum": 1,
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state == state_selection"
        },
        {
          "fold": [
            "total_proportion_ratio",
            "house_price_ratio", 
            "inflation_rate_ratio",
            "min_wage_ratio"
          ],
          "as": ["variable", "ratio_value"]
        },
        {
          "calculate": "datum.variable == 'total_proportion_ratio' ? 'Diversity' : datum.variable == 'house_price_ratio' ? 'House Price' : datum.variable == 'inflation_rate_ratio' ? 'Inflation Rate' : 'Minimum Wage'",
          "as": "variable_label"
        }
      ],
      "mark": {
        "type": "line",
        "point": true,
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "title": "Time Interval",
          "axis": {
            "labelAngle": 0,
            "labelColor": "black",
            "gridColor": "lightgray",
            "tickColor": "gray",
            "domainColor": "gray",
            "grid": true
          }
        },
        "y": {
          "field": "ratio_value",
          "type": "quantitative",
          "title": "Amount of change between years (x times)",
          "scale": {"domain": {"param": "brush"}, "zero": false},
          "axis": {
            "labelAngle": 0,
            "labelColor": "black",
            "tickColor": "gray",
            "domainColor": "gray",
            "gridColor": "lightgray",
            "grid": true
          }
        },
        "color": {
          "field": "variable_label",
          "type": "nominal",
          "legend": {
            "title": "Variable",
            "orient": "left"
          }
        },
        "tooltip": [
          {
            "field": "variable_label",
            "type": "nominal",
            "title": "Variable"
          },
          {
            "field": "ratio_value",
            "type": "quantitative",
            "title": "Amount of Change (x times)",
            "format": ".2f"
          },
          {
            "field": "period",
            "type": "ordinal",
            "title": "Period"
          }
        ]
      }
    }
  ]
    },
    {
      "width": 80,
      "height": 500,
      "mark": "line",
      "params": [
        {"name": "brush", "select": {"type": "interval", "encodings": ["y"]}}
      ],
      "transform": [
        {
          "filter": "datum.state == state_selection"
        },
        {
          "fold": [
            "total_proportion_ratio",
            "house_price_ratio", 
            "inflation_rate_ratio",
            "min_wage_ratio"
          ],
          "as": ["variable", "ratio_value"]
        },
        {
          "calculate": "datum.variable == 'total_proportion_ratio' ? 'Diversity' : datum.variable == 'house_price_ratio' ? 'House Price' : datum.variable == 'inflation_rate_ratio' ? 'Inflation Rate' : 'Minimum Wage'",
          "as": "variable_label"
        }
      ],
      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "axis": null
        },
        "y": {
          "field": "ratio_value",
          "type": "quantitative",
          "scale": {"zero": false},
          "axis": {
            "tickCount": 3,
            "grid": false
          },
          "title": null
        },
        "color": {
          "field": "variable_label",
          "type": "nominal",
          "legend": null
        }
      }
    }
  ]
}
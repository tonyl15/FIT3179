{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Inflation Rate Over Time by Capital City",
  "width": 500,
  "height": 500,
  "data": {
    "url": "https://raw.githubusercontent.com/tonyl15/FIT3179/refs/heads/main/data/Inflation%20rate.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Date": "date:'%b-%y'"
      }
    }
  },
  "params": [
    {
      "name": "city_selection",
      "value": "Australia",
      "bind": {
        "input": "select",
        "options": [
          "Sydney",
          "Melbourne",
          "Brisbane",
          "Adelaide",
          "Perth",
          "Hobart",
          "Darwin",
          "Canberra",
          "Australia"
        ],
        "name": "Select City: "
      }
    }
  ],
  "transform": [
    {
      "fold": [
        "Sydney",
        "Melbourne",
        "Brisbane",
        "Adelaide",
        "Perth",
        "Hobart",
        "Darwin",
        "Canberra",
        "Australia"
      ],
      "as": [
        "City",
        "Inflation_Rate"
      ]
    },
    {
      "filter": "datum.City == city_selection"
    },
    {
      "calculate": "quarter(datum.Date)",
      "as": "Quarter"
    },
    {
      "calculate": "year(datum.Date)",
      "as": "Year"
    }
  ],
  "mark": {
    "type": "arc",
    "innerRadius": 200,
    "stroke": "white",
    "strokeWidth": 0.5
  },
  "encoding": {
    "theta": {
      "field": "Year",
      "type": "ordinal",
      "sort": "ascending"
    },
    "radius": {
      "field": "Quarter",
      "type": "ordinal",
      "scale": {
        "type": "band",
        "range": [150, 240]
      }
    },
    "color": {
      "field": "Inflation_Rate",
      "type": "quantitative",
      "title": "Inflation Rate (%)"
    },
    "tooltip": [
      {"field": "Quarter", "type": "quantitative", "title": "Quarter"},
      {"field": "Year", "type": "ordinal", "title": "Year"},
      {"field": "Date", "type": "temporal", "title": "Month", "format": "%B"},
      {"field": "Inflation_Rate", "type": "quantitative", "title": "Inflation Rate (%)", "format": ".1f"}
    ]
  }
}
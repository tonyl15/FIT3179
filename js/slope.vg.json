{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Growth/Decline Ratios of Variables Over Time",
  "width": 500,
  "height": 500,
  "data": {
    "url": "https://raw.githubusercontent.com/tonyl15/FIT3179/refs/heads/main/data/rate_of_change.csv"
  },
  "params": [
    {
      "name": "state_selection",
      "bind": {
        "input": "select",
        "options": ["NSW", "VIC", "QLD", "SA", "WA", "TA", "NT", "ACT"],
        "name": "Select State: "
      },
      "value": "NSW"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "black",
        "strokeWidth": 2,
        "opacity": 0.7
      },
      "encoding": {
        "y": {
          "datum": 1,
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state == state_selection"
        },
        {
          "fold": [
            "total_proportion_ratio",
            "house_price_ratio", 
            "inflation_rate_ratio",
            "min_wage_ratio"
          ],
          "as": ["variable", "ratio_value"]
        },
        {
          "calculate": "datum.variable == 'total_proportion_ratio' ? 'Overseas Population Proportion' : datum.variable == 'house_price_ratio' ? 'House Price' : datum.variable == 'inflation_rate_ratio' ? 'Inflation Rate' : 'Minimum Wage'",
          "as": "variable_label"
        }
      ],
      "mark": {
        "type": "line",
        "point": true,
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "title": "Time Interval",
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "ratio_value",
          "type": "quantitative",
          "title": "Amount of change between years (x times)",
          "scale": {"zero": false}
        },
        "color": {
          "field": "variable_label",
          "type": "nominal",
          "legend": {
            "title": "Variable"
          }
        },
        "tooltip": [
          {
            "field": "variable_label",
            "type": "nominal",
            "title": "Variable"
          },
          {
            "field": "ratio_value",
            "type": "quantitative",
            "title": "Change Compared to Previous Year",
            "format": ".3f"
          },
          {
            "field": "period",
            "type": "ordinal",
            "title": "Period"
          }
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "y": "shared"
    }
  }
}
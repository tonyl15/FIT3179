{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Inflation Rate in Australia by Capital City Over Time",
  "width": 1200,
  "height": 500,
  "data": {
    "url": "https://raw.githubusercontent.com/tonyl15/FIT3179/refs/heads/main/data/Inflation%20rate.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Date": "date:'%b-%y'"
      }
    }
  },
  "transform": [
    {
      "fold": [
        "Sydney",
        "Melbourne",
        "Brisbane",
        "Adelaide",
        "Perth",
        "Hobart",
        "Darwin",
        "Canberra",
        "Australia"
      ],
      "as": [
        "City",
        "Inflation_Rate"
      ]
    }
  ],
  "encoding": {
    "x": {
      "field": "Date",
      "type": "temporal",
      "title": "Year",
      "axis": {
        "format": "%Y",
        "labelAngle": -45
      }
    },
    "y": {
      "field": "Inflation_Rate",
      "type": "quantitative",
      "title": "Inflation Rate (%)"
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "city_selection",
          "select": {
            "type": "point",
            "fields": ["City"]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "line",
        "point": {"filled": true, "size": 15},
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "City",
          "type": "nominal",
          "title": "City"
        },
        "opacity": {
          "condition": {
            "param": "city_selection",
            "value": 1
          },
          "value": 0.2
        },
        "tooltip": [
          {
            "field": "Date",
            "type": "temporal",
            "format": "%b %Y"
          },
          {
            "field": "City",
            "type": "nominal"
          },
          {
            "field": "Inflation_Rate",
            "type": "quantitative",
            "format": ".1f",
            "title": "Inflation Rate (%)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 20,
        "fontSize": 11.5,
        "fontStyle": "italic"
      },
      "encoding": {
        "text": {
          "condition": {
            "test": "datum.Inflation_Rate == 13.1",
            "value": "Highest inflation rate recorded in Sydney in 1982"
          },
          "value": ""
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -12,
        "fontSize": 11.5,
        "fontStyle": "italic"
      },
      "encoding": {
        "text": {
          "condition": {
            "test": "datum.Inflation_Rate == -1.8",
            "value": "Lowest inflation rate recorded in Darwin in 2020"
          },
          "value": ""
        }
      }
    }
      
  ]
}